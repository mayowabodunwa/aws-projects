# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.
#
# db_password is deliberately not listed here. Pass it out of band so it never
# lands in a file:
#
#   export TF_VAR_db_password="$(openssl rand -base64 24)"
#
# Bucket names are globally unique across all of AWS, so the two below have to be
# changed to something of your own before apply will succeed.

app_instance_type = "t2.micro"

db_username = "wpadmin"

backend_bucket = "CHANGE-ME-terraform-state-bucket"

object_bucket = "CHANGE-ME-wordpress-object-bucket"

region = "us-east-1"

dynamodb_table = "state-lock-db"

billing_mode = "PAY_PER_REQUEST"

hash_key = "LockID"

attribute_name = "LockID"

attribute_type = "S"
